-- 13. AUTO BUY MERCHANT ITEMS MODULE
local isBuyingMerchant = false
local function processMerchantPurchase()
    if isBuyingMerchant or not autoBuyMerchantEnabled then return end
    if not (merchantGetItemsRF and merchantBuyRF) then return end

    isBuyingMerchant = true
    pcall(function()
        local items = merchantGetItemsRF:InvokeServer()
        if type(items) == "table" then
            local currentRefresh = math.floor(workspace:GetServerTimeNow() / 300)
            for slotKey, stock in pairs(items) do
                local slotStr = tostring(slotKey)
                local count = tonumber(stock) or 0
                if count > 0 then
                    for _ = 1, count do
                        if not autoBuyMerchantEnabled then break end
                        merchantBuyRF:InvokeServer("Normal", slotStr, currentRefresh)
                        task.wait(0.15)
                    end
                end
            end
        end
    end)
    isBuyingMerchant = false
end


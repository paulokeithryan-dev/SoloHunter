task.spawn(function()
    local acNames = {"anticheat", "ac", "detector", "physicscheck", "cheat", "validation", "security", "exploit"}
    
    local function disableAC(v)
        if v:IsA("LocalScript") and v ~= script then
            local scriptName = v.Name:lower()
            for _, name in ipairs(acNames) do
                if scriptName:find(name) then
                    v.Enabled = false
                    pcall(function() v:Destroy() end)
                    warn("MCE Engine: Bypassed active client security script: " .. v.Name)
                    break
                end
            end
        end
    end

    local function monitorContainer(container)
        if not container then return end
        for _, v in ipairs(container:GetDescendants()) do disableAC(v) end
        container.DescendantAdded:Connect(disableAC)
    end

    task.spawn(function()
        local playerScripts = player:WaitForChild("PlayerScripts", 10)
        if playerScripts then monitorContainer(playerScripts) end
    end)

    if player.Character then monitorContainer(player.Character) end
    player.CharacterAdded:Connect(monitorContainer)
end)

